GOOGLE_SAFE_BROWSING_API_KEY=your_key_here

# GitHub Actions trigger for the ClamAV static scan.
# PAT needs `actions:write` on the repo. Never commit the real token.
GITHUB_PAT=your_github_pat_here
GITHUB_REPOSITORY=owner/repo
# PRIVATE repo that receives uploads for ClamAV scanning (created by
# `npm run setup:quarantine`). Do NOT point this at a public repo.
GITHUB_QUARANTINE_REPOSITORY=owner/cyber-detector-quarantine
# GITHUB_REF_NAME=main
